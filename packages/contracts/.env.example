# Deployer private key — NEVER commit the real value
# For Anvil testing, use Anvil's default test key:
# 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Initial owner address — MUST match the wallet derived from PRIVATE_KEY
# For Anvil: 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
OWNER_ADDRESS=0xYOUR_WALLET_ADDRESS_HERE

# Treasury address — receives protocol fees
TREASURY_ADDRESS=0xYOUR_TREASURY_ADDRESS_HERE

# Protocol fee in basis points (250 = 2.5%)
FEE_BPS=250

# Fuji RPC URL — required for Fuji broadcast (manual step by Mateo)
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
